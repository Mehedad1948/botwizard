// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  phone          String?      @unique
  firstName      String?
  lastName       String?
  username       String?
  photoUrl       String?
  telegramId     String?      @unique
  otpCode        String?
  otpExpires     DateTime?
  otpAttempts    Int          @default(0)
  otpRequestedAt DateTime?
  role           Role         @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bots           Bot[]
  loginTokens    LoginToken[]
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Bot {
  id                      String                           @id @default(cuid())
  userId                  String
  user                    User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform                BotPlatform                      @default(TELEGRAM)
  token                   String
  username                String
  ownerPlatformUserId     String?
  connectionCodeHash      String?
  connectionCodeExpiresAt DateTime?
  webhookId               String?                          @unique
  webhookSecret           String?
  isActive                Boolean                          @default(true)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  posts                   Post[]
  campaigns               Campaign[]
  connectedChats          ConnectedChat[]
  subscribers             BotSubscriber[]
  notificationTopics      NotificationTopic[]
  notificationDispatches  SubscriberNotificationDispatch[]
  deliveries              Delivery[]
  conversations           BotConversation[]

  @@unique([platform, token])
  @@index([userId, platform])
}

model Post {
  id                     String                           @id @default(cuid())
  botId                  String
  bot                    Bot                              @relation(fields: [botId], references: [id], onDelete: Cascade)
  title                  String?
  /// Message text, or the caption when the post has media.
  content                String?
  /// Telegram message entities for `content`. Non-null means the post can be sent from stored data.
  entities               Json?
  mediaUrl               String?
  mediaType              MediaType                        @default(NONE)
  /// Platform file id, valid for this bot only.
  mediaFileId            String?
  /// URL buttons: [[{ text, url }]]
  buttons                Json?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  archivedAt             DateTime?
  /// Provenance of posts captured in the owner's private chat (legacy delivery fallback).
  sourceChatId           String?
  sourceMessageId        Int?
  campaigns              Campaign[]
  notificationTopics     PostNotificationTopic[]
  notificationDispatches SubscriberNotificationDispatch[]

  @@index([botId, archivedAt])
}

enum ScheduleKind {
  ONCE
  INTERVAL
  DAILY
  WEEKLY
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id                     String                           @id @default(cuid())
  botId                  String
  bot                    Bot                              @relation(fields: [botId], references: [id], onDelete: Cascade)
  postId                 String
  post                   Post                             @relation(fields: [postId], references: [id], onDelete: Cascade)
  name                   String?
  status                 CampaignStatus                   @default(ACTIVE)
  scheduleKind           ScheduleKind
  /// INTERVAL only, minimum 60.
  intervalMinutes        Int?
  /// HH:MM wall-clock times for DAILY and WEEKLY.
  times                  String[]
  /// WEEKLY only, JavaScript numbering (0 = Sunday).
  weekdays               Int[]
  timezone               String                           @default("Asia/Tehran")
  /// First run for ONCE and INTERVAL; lower bound for the others.
  startsAt               DateTime                         @default(now())
  endsAt                 DateTime?
  maxRuns                Int?
  jitterMinutes          Int                              @default(0)
  runCount               Int                              @default(0)
  lastRunAt              DateTime?
  /// Null when the campaign is completed.
  nextRun                DateTime?
  notifySubscribers      Boolean                          @default(false)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  targets                CampaignTarget[]
  deliveries             Delivery[]
  notificationDispatches SubscriberNotificationDispatch[]

  @@index([status, nextRun])
  @@index([botId, createdAt])
}

model CampaignTarget {
  campaignId    String
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  destinationId String
  destination   ConnectedChat @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@id([campaignId, destinationId])
  @@index([destinationId])
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum DeliveryTrigger {
  SCHEDULED
  MANUAL
}

model Delivery {
  id                String          @id @default(cuid())
  botId             String
  bot               Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  destinationId     String?
  destination       ConnectedChat?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  /// Snapshot so history survives destination removal.
  chatId            String
  chatTitle         String
  occurrenceKey     String
  trigger           DeliveryTrigger @default(SCHEDULED)
  status            DeliveryStatus  @default(PENDING)
  runAt             DateTime        @default(now())
  attempts          Int             @default(0)
  lockedAt          DateTime?
  errorKind         String?
  errorMessage      String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([campaignId, chatId, occurrenceKey])
  @@index([status, runAt])
  @@index([campaignId, createdAt])
  @@index([botId, createdAt])
}

enum ChatType {
  GROUP
  SUPERGROUP
  CHANNEL
  UNKNOWN
}

enum DestinationStatus {
  ACTIVE
  NO_PERMISSION
  REMOVED
}

model BotConversation {
  id        String   @id
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  chatId    String
  kind      String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId, chatId])
  @@index([expiresAt])
}

model ConnectedChat {
  id            String            @id @default(cuid())
  botId         String
  bot           Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  chatId        String // platform chat id of the group or channel
  chatTitle     String
  chatType      ChatType          @default(UNKNOWN)
  status        DestinationStatus @default(ACTIVE)
  statusReason  String?
  lastCheckedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  targets       CampaignTarget[]
  deliveries    Delivery[]

  @@unique([botId, chatId])
}

model BotSubscriber {
  id                String                           @id @default(cuid())
  botId             String
  bot               Bot                              @relation(fields: [botId], references: [id], onDelete: Cascade)
  platformUserId    String
  privateChatId     String
  username          String?
  firstName         String?
  lastName          String?
  languageCode      String?
  status            SubscriberStatus                 @default(ACTIVE)
  source            String?
  startParameter    String?
  firstSeenAt       DateTime                         @default(now())
  lastSeenAt        DateTime?
  lastInteractionAt DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  subscriptions     SubscriberTopicSubscription[]
  dispatches        SubscriberNotificationDispatch[]

  @@unique([botId, platformUserId])
  @@index([botId])
  @@index([status])
  @@index([lastInteractionAt])
  @@index([botId, status, id])
}

model NotificationTopic {
  id            String                        @id @default(cuid())
  botId         String
  bot           Bot                           @relation(fields: [botId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  callbackKey   String
  description   String?
  isActive      Boolean                       @default(true)
  sortOrder     Int                           @default(0)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  subscriptions SubscriberTopicSubscription[]
  posts         PostNotificationTopic[]

  @@unique([botId, slug])
  @@unique([botId, callbackKey])
  @@index([botId])
  @@index([isActive])
  @@index([botId, isActive, sortOrder])
}

model SubscriberTopicSubscription {
  id           String            @id @default(cuid())
  subscriberId String
  subscriber   BotSubscriber     @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  topicId      String
  topic        NotificationTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  isEnabled    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([subscriberId, topicId])
  @@index([topicId])
  @@index([isEnabled])
  @@index([topicId, isEnabled, subscriberId])
}

model PostNotificationTopic {
  id        String            @id @default(cuid())
  postId    String
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicId   String
  topic     NotificationTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  createdAt DateTime          @default(now())

  @@unique([postId, topicId])
  @@index([topicId])
}

model SubscriberNotificationDispatch {
  id            String                     @id @default(cuid())
  dispatchKey   String                     @unique
  botId         String
  bot           Bot                        @relation(fields: [botId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign?                  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  postId        String
  post          Post                       @relation(fields: [postId], references: [id], onDelete: Cascade)
  subscriberId  String
  subscriber    BotSubscriber              @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  occurrenceKey String
  scheduledFor  DateTime?
  status        NotificationDispatchStatus @default(PENDING)
  attemptCount  Int                        @default(0)
  errorLog      String?
  lastAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([botId])
  @@index([campaignId])
  @@index([postId])
  @@index([subscriberId])
  @@index([status])
  @@index([botId, status, id])
}

enum Role {
  USER
  ADMIN
}

enum BotPlatform {
  TELEGRAM
  BALE
}

enum MediaType {
  NONE
  IMAGE
  VIDEO
  DOCUMENT
  ANIMATION
  AUDIO
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

enum NotificationDispatchStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  BLOCKED
}
